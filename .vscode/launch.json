    "version": "0.2.0",
    "configurations": [

        {
            "name": "Debug executable 'jlox-treewalk-interpreter'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "run",
                    "--manifest-path=jlox-treewalk-interpreter/Cargo.toml",
                    "--bin=jlox-treewalk-interpreter"
                ]
            },
            "args": ["programs/test.lox"]
        },
        {
            "name": "Debug unit tests in executable 'jlox-treewalk-interpreter'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--manifest-path=jlox-treewalk-interpreter/Cargo.toml",
                    "--bin=jlox-treewalk-interpreter"
                ]
            }
        }
    ]
}
